# Firebase Configuration
# Get these values from your Firebase project settings:
# 1. Go to https://console.firebase.google.com
# 2. Create a new project (or select existing)
# 3. Click the gear icon > Project settings
# 4. Scroll down to "Your apps" and click "Add app" > Web
# 5. Copy the config values below

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser)
# Same value as NEXT_PUBLIC_FIREBASE_API_KEY; used to verify ID tokens in API routes
FIREBASE_API_KEY=your-api-key
# https://console.anthropic.com — used by /api/parse-url
ANTHROPIC_API_KEY=your-anthropic-key
